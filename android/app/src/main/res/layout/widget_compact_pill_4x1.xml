<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_pill_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="12dp"
    android:paddingBottom="5dp">

    <!-- Circular Album Art (Pre-Rendered Anti-Aliased Circle Mask) -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_button_subtle"
        android:contentDescription="Album Art"
        android:scaleType="fitXY" />

    <!-- Center Track Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Starboy"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="The Weeknd, Daft Punk"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controls Cluster -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Previous -->
        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Track"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/widget_on_surface" />

        <!-- Play / Pause FAB -->
        <RelativeLayout
            android:id="@+id/widget_play_fab_container"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_play_fab">

            <ImageView
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play or Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow"
                android:tint="@color/widget_on_primary" />
        </RelativeLayout>

        <!-- Next -->
        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Track"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>

</LinearLayout>
